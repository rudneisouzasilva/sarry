# Segredos das Edge Functions. Configure em Supabase > Edge Functions > Secrets
# (ou `supabase secrets set --env-file supabase/.env`). Nunca faça commit do arquivo preenchido.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Conta brasileira normalmente usa Western America. Outros: https://openapi.tuyaeu.com, https://openapi.tuyacn.com, https://openapi.tuyain.com
TUYA_BASE_URL=https://openapi.tuyaus.com
TUYA_UID=
# Texto aleatório longo, o mesmo salvo no Vault para o pg_cron
CRON_SECRET=
